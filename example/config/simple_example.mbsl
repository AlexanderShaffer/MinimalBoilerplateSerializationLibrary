// Assigns the group of all structs that follow.
group example_group

// Assigns the endianness of all packages that follow. Valid values are little, big, and native. The default is little.
endianness big

// Defines a C++ struct in the mbsl::example_group namespace with automatically generated serialization and deserialization functions.
package example_package {
  double x_
  int y_
  std::array<std::uint8_t, 15> z_
}
